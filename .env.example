# ── Legal RAG Assistant — local stack env ──────────────────────────
# All vars are optional unless marked REQUIRED. Copy to .env.

# Gemini API (AI Studio) key — REQUIRED for embeddings + answers.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_OUTPUT_DIMS=768

# Weaviate (docker compose service on the local stack)
# REQ UIRED when running inside compose, defaults to localhost for bare runs.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key_here
WEAVIATE_COLLECTION=LegalChunk
WEAVIATE_GRPC_PORT=50051

# Inbound auth: when set, every endpoint except /health requires this value
# via the x-internal-key header. The webapp backend sends it.
INTERNAL_API_KEY=

# Google Drive corpus — REQUIRED for ingestion.
DRIVE_ROOT_FOLDER_ID=your_google_drive_root_folder_id_here
DRIVE_ALLOWED_EXTS=pdf,txt
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Optional push-token for /drive-events (Pub/Sub push subscriptions).
DRIVE_PUBSUB_TOKEN=
# Debounce window for drive-events full scans (seconds).
DRIVE_EVENT_DEBOUNCE_SECONDS=300

# Ingestion state: 'file' (compose volume) or 'gcs' (Cloud Run).
INGESTION_STATE_BACKEND=file
# Only used when INGESTION_STATE_BACKEND=gcs:
INGESTION_STATE_GCS_BUCKET=
INGESTION_STATE_GCS_BLOB=ingestion/ingestion_state.json

# Retrieval tuning.
RAG_STATUTE_CHUNKS=3
RAG_CASELAW_CHUNKS=2

# Runtime env: 'local' loads .env; 'prod' does not (and disables /docs UI).
ENV=local
PORT=8080